{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/BE/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/BE/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/BE",
  "projects": {
    "BE": {
      "type": "application",
      "root": "apps/BE",
      "entryFile": "main",
      "sourceRoot": "apps/BE/src",
      "compilerOptions": {
        "tsConfigPath": "apps/BE/tsconfig.app.json"
      }
    },
    "common": {
      "type": "application",
      "root": "apps/common",
      "entryFile": "main",
      "sourceRoot": "apps/common/src",
      "compilerOptions": {
        "tsConfigPath": "apps/common/tsconfig.app.json"
      }
    },
    "official_backend": {
      "type": "application",
      "root": "apps/official_backend",
      "entryFile": "main",
      "sourceRoot": "apps/official_backend/src",
      "compilerOptions": {
        "tsConfigPath": "apps/official_backend/tsconfig.app.json"
      }
    },
    "user_backend": {
      "type": "application",
      "root": "apps/user_backend",
      "entryFile": "main",
      "sourceRoot": "apps/user_backend/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user_backend/tsconfig.app.json"
      }
    }
  }
}